APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Shown in the generated API docs (config/scramble.php); defaults to 0.0.1.
# API_VERSION=0.0.1

BCRYPT_ROUNDS=12

# Comma-separated list of trusted load balancer/reverse proxy/CDN IPs or CIDR
# ranges. Set this when the app sits behind one in production, so RestrictToAllowedIps
# and other IP-based checks see the real client IP instead of the proxy's.
#
# Never set this to "*". Trusting every proxy means trusting whatever the client
# puts in X-Forwarded-For, which hands an attacker control of both the
# Telescope/Pulse/health IP allowlist and the login rate limiter's IP bucket.
# TRUSTED_PROXIES=10.0.0.0/8

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Only needed if the sqlite3 CLI (used by spatie/laravel-backup to dump the DB) isn't on PATH.
# SQLITE3_DUMP_BINARY_PATH=

WAF_ENABLED=true

# Strict-Transport-Security. Leave on wherever the site is served over HTTPS;
# set to false only for a deployment that is genuinely plain HTTP.
HSTS_ENABLED=true

# Content-Security-Policy. Ships report-only (see config/secure-headers.php) —
# walk the admin panel with the browser console open, fix what reports, then
# set CSP_REPORT_ONLY=false to enforce. Set CSP_ENABLED=false locally if the
# Vite dev server's violations get noisy.
CSP_ENABLED=true
CSP_REPORT_ONLY=true

HONEYPOT_ENABLED=true

TELESCOPE_ENABLED=true
TELESCOPE_DB_CONNECTION=telescope
TELESCOPE_PRUNE_HOURS=48
TELESCOPE_ALLOWED_IPS=127.0.0.1

PULSE_ENABLED=true
PULSE_DB_CONNECTION=pulse
# PULSE_ALLOWED_IPS defaults to TELESCOPE_ALLOWED_IPS; set this to diverge from it.
# PULSE_ALLOWED_IPS=127.0.0.1

HEALTH_DB_CONNECTION=health
# HEALTH_ALLOWED_IPS defaults to TELESCOPE_ALLOWED_IPS; set this to diverge from it.
# HEALTH_ALLOWED_IPS=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Defaults to true when APP_ENV=production; set explicitly for any other
# environment served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
