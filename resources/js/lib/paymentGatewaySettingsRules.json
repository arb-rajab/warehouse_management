{
    "rules": {
        "enabled_source": ["required", "string", "in:env,admin"],
        "gateways.bkash.enabled": ["nullable", "boolean"],
        "gateways.bkash.mode": ["required", "string", "in:sandbox,live"],
        "gateways.bkash.app_key": [
            "required_with:gateways.bkash.app_secret,gateways.bkash.username,gateways.bkash.password,gateways.bkash.currency",
            "nullable",
            "string",
            "max:100",
            "regex:/^[A-Za-z0-9]+$/D"
        ],
        "gateways.bkash.app_secret": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.bkash.app_secret_clear": ["nullable", "boolean"],
        "gateways.bkash.username": [
            "required_with:gateways.bkash.app_key,gateways.bkash.app_secret,gateways.bkash.password,gateways.bkash.currency",
            "nullable",
            "string",
            "max:100",
            "regex:/^\\S+$/D"
        ],
        "gateways.bkash.password": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.bkash.password_clear": ["nullable", "boolean"],
        "gateways.bkash.currency": [
            "required_with:gateways.bkash.app_key,gateways.bkash.app_secret,gateways.bkash.username,gateways.bkash.password",
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
        "gateways.nagad.enabled": ["nullable", "boolean"],
        "gateways.nagad.merchant_id": [
            "required_with:gateways.nagad.merchant_number,gateways.nagad.pg_public_key,gateways.nagad.merchant_private_key,gateways.nagad.mode",
            "nullable",
            "string",
            "max:20",
            "regex:/^[0-9]{6,20}$/D"
        ],
        "gateways.nagad.merchant_number": [
            "nullable",
            "string",
            "max:11",
            "regex:/^01[0-9]{9}$/D"
        ],
        "gateways.nagad.pg_public_key": [
            "required_with:gateways.nagad.merchant_id,gateways.nagad.merchant_number,gateways.nagad.merchant_private_key,gateways.nagad.mode",
            "nullable",
            "string",
            "max:4096",
            "regex:/^[A-Za-z0-9+\\/=\\s-]+$/D"
        ],
        "gateways.nagad.merchant_private_key": [
            "nullable",
            "string",
            "max:8192",
            "regex:/^[A-Za-z0-9+\\/=\\s-]+$/D"
        ],
        "gateways.nagad.merchant_private_key_clear": ["nullable", "boolean"],
        "gateways.nagad.mode": [
            "required_with:gateways.nagad.merchant_id,gateways.nagad.merchant_number,gateways.nagad.pg_public_key,gateways.nagad.merchant_private_key",
            "nullable",
            "string",
            "in:sandbox,live"
        ],
        "gateways.sslcommerz.enabled": ["nullable", "boolean"],
        "gateways.sslcommerz.mode": ["required", "string", "in:sandbox,live"],
        "gateways.sslcommerz.store_id": [
            "required_with:gateways.sslcommerz.store_password,gateways.sslcommerz.currency",
            "nullable",
            "string",
            "max:100",
            "regex:/^[A-Za-z0-9_-]+$/D"
        ],
        "gateways.sslcommerz.store_password": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.sslcommerz.store_password_clear": ["nullable", "boolean"],
        "gateways.sslcommerz.currency": [
            "required_with:gateways.sslcommerz.store_id,gateways.sslcommerz.store_password",
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
