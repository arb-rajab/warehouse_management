            "required_with:gateways.ngenius.api_key,gateways.ngenius.currency,gateways.ngenius.mode",
            "nullable",
            "string",
            "max:36",
            "regex:/^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$/D"
        ],
        "gateways.ngenius.api_key": [
            "nullable",
            "string",
            "max:512",
            "regex:/^[A-Za-z0-9+\\/=]+$/D"
