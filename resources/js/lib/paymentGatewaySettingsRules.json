            "required_with:gateways.ngenius.outlet_id,gateways.ngenius.api_key,gateways.ngenius.mode",
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
        "gateways.ngenius.mode": [
            "required_with:gateways.ngenius.outlet_id,gateways.ngenius.api_key,gateways.ngenius.currency",
            "nullable",
            "string",
            "in:sandbox,live"
        ],
        "gateways.voguepay.enabled": ["nullable", "boolean"],
        "gateways.voguepay.mode": ["required", "string", "in:sandbox,live"],
        "gateways.voguepay.merchant_id": [
            "required_with:gateways.voguepay.currency",
            "nullable",
            "string",
            "max:100",
            "regex:/^[A-Za-z0-9_-]+$/D"
        ],
        "gateways.voguepay.currency": [
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
        "gateways.toyyibpay.enabled": ["nullable", "boolean"],
