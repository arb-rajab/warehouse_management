        "gateways.iyzico.api_key": [
            "required_with:gateways.iyzico.secret_key,gateways.iyzico.currency",
            "nullable",
            "string",
            "max:255",
            "regex:/^[A-Za-z0-9_-]+$/D"
        ],
        "gateways.iyzico.secret_key": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.iyzico.secret_key_clear": ["nullable", "boolean"],
        "gateways.iyzico.currency": [
            "required_with:gateways.iyzico.api_key,gateways.iyzico.secret_key",
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
