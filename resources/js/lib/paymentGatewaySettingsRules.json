            "nullable",
            "string",
            "max:20",
            "regex:/^[0-9]{4,20}$/D"
        ],
        "gateways.payhere.secret": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.payhere.secret_clear": ["nullable", "boolean"],
        "gateways.payhere.currency": [
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
        "gateways.aamarpay.enabled": ["nullable", "boolean"],
        "gateways.aamarpay.mode": ["required", "string", "in:sandbox,live"],
        "gateways.aamarpay.store_id": [
            "required_with:gateways.aamarpay.signature_key,gateways.aamarpay.currency",
            "nullable",
            "string",
            "max:100",
            "regex:/^[A-Za-z0-9_-]+$/D"
        ],
        "gateways.aamarpay.signature_key": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.aamarpay.signature_key_clear": ["nullable", "boolean"],
        "gateways.aamarpay.currency": [
            "required_with:gateways.aamarpay.store_id,gateways.aamarpay.signature_key",
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
        "gateways.ngenius.enabled": ["nullable", "boolean"],
