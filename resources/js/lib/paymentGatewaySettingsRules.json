            "nullable",
            "string",
            "max:255",
            "regex:/^[A-Za-z0-9_-]+$/D"
        ],
        "gateways.toyyibpay.user_secret_key_clear": ["nullable", "boolean"],
        "gateways.toyyibpay.mode": [
            "required_with:gateways.toyyibpay.category_code,gateways.toyyibpay.user_secret_key",
            "nullable",
            "string",
            "in:sandbox,live"
        ],
        "gateways.stripe.enabled": ["nullable", "boolean"],
        "gateways.stripe.publishable_key": [
            "required_with:gateways.stripe.secret_key,gateways.stripe.currency",
            "nullable",
            "string",
            "max:255",
            "regex:/^pk_(test|live)_[A-Za-z0-9]+$/D"
        ],
        "gateways.stripe.secret_key": [
            "nullable",
            "string",
            "max:255",
            "regex:/^(sk|rk)_(test|live)_[A-Za-z0-9]+$/D"
        ],
        "gateways.stripe.secret_key_clear": ["nullable", "boolean"],
        "gateways.stripe.currency": [
            "nullable",
            "string",
            "max:3",
            "regex:/^[A-Z]{3}$/D"
        ],
        "gateways.paytm.enabled": ["nullable", "boolean"],
        "gateways.paytm.merchant_id": [
            "required_with:gateways.paytm.merchant_key,gateways.paytm.merchant_website,gateways.paytm.channel,gateways.paytm.industry_type,gateways.paytm.mode",
            "nullable",
            "string",
            "max:50",
            "regex:/^[A-Za-z0-9]+$/D"
        ],
        "gateways.paytm.merchant_key": [
            "nullable",
            "string",
            "max:255",
            "regex:/^\\S+$/D"
        ],
        "gateways.paytm.merchant_key_clear": ["nullable", "boolean"],
        "gateways.paytm.merchant_website": [
            "required_with:gateways.paytm.merchant_id,gateways.paytm.merchant_key,gateways.paytm.channel,gateways.paytm.industry_type,gateways.paytm.mode",
            "nullable",
            "string",
            "max:50",
            "regex:/^[A-Za-z0-9_]+$/D"
        ],
        "gateways.paytm.channel": ["nullable", "string", "in:WEB,WAP"],
        "gateways.paytm.industry_type": [
            "nullable",
            "string",
            "max:50",
            "regex:/^[A-Za-z0-9_]+$/D"
        ],
        "gateways.paytm.mode": [
            "required_with:gateways.paytm.merchant_id,gateways.paytm.merchant_key,gateways.paytm.merchant_website,gateways.paytm.channel,gateways.paytm.industry_type",
            "nullable",
            "string",
            "in:sandbox,live"
        ],
        "current_password": ["required", "string"]
    },
    "serverOnly": {
        "current_password": ["current_password:store"]
    }
