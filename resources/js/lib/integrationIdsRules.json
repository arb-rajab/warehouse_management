            "google_analytics_tracking_id": [
                "nullable",
                "string",
                "max:40",
                "regex:/^[A-Za-z]{1,3}-[A-Za-z0-9-]{3,30}$/D"
            ],
            "facebook_pixel_id": [
                "nullable",
                "string",
                "max:40",
                "regex:/^[0-9]{5,20}$/D"
            ]
        },
        "facebookChat": {
            "facebook_page_id": [
                "nullable",
                "string",
                "max:40",
                "regex:/^[0-9]{5,20}$/D"
            ]
        },
        "facebookComments": {
            "facebook_app_id": [
                "nullable",
                "string",
                "max:40",
                "regex:/^[0-9]{5,20}$/D"
            ]
        }
    },
    "serverOnly": ["settings", "settings.*"]
}
