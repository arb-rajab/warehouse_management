# Production environment template. NOT a copy of .env.example: that file is for
# local development and CI, and several of its values (APP_DEBUG=true,
# SESSION_SECURE_COOKIE=false, CSP_REPORT_ONLY=true, TELESCOPE_ENABLED=true,
# MAIL_MAILER=log, DB_CONNECTION=sqlite) are unsafe or wrong on a live server
# and override the safe production defaults if copied across.
#
# Use: copy to $DEPLOY_PATH/shared/.env on the server (the deploy links it into
# every release) and replace every CHANGE_ME and every empty value that its
# comment says is required. Never commit the filled-in file, and never put a
# real secret in this one: it only ever holds placeholders.
# See .ai/go-live-checklist-20261021.md section 2 and Appendix A.
# tests/Feature/ProductionEnvExampleTest.php pins the safe values below.

APP_NAME="CHANGE_ME"
# The session cookie and cache names derive from APP_NAME. Choose it once:
# changing it later logs everybody out.
APP_ENV=production
APP_DEBUG=false
# Generate once with `php artisan key:generate --show` and paste it here. Never
# reuse a key from another server or from the legacy store.
APP_KEY=
# Public https URL, no trailing slash. The public disk URL derives from it.
APP_URL=https://CHANGE_ME.example.com

APP_LOCALE=en
DEFAULT_LANGUAGE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Leave unset behind a proxy that does not report https (it would redirect
# forever); `On` only if the app terminates TLS itself.
# FORCE_HTTPS=On

# Set to the proxy / CDN / load balancer IPs or CIDR ranges if (and only if)
# the site sits behind one, so the login rate limit and the Telescope, Pulse
# and health IP allowlists see the real client address. Never "*".
# TRUSTED_PROXIES=10.0.0.0/8

# Logging: rotate daily (LOG_DAILY_DAYS files kept) and keep the noise down.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Database: the deploy script and the backups both assume MySQL. The Telescope,
# Pulse and health connections below are small SQLite files and need pdo_sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=
TELESCOPE_DB_CONNECTION=telescope
PULSE_DB_CONNECTION=pulse
HEALTH_DB_CONNECTION=health

# Security headers and the WAF stay on.
WAF_ENABLED=true
HSTS_ENABLED=true
HONEYPOT_ENABLED=true
CSP_ENABLED=true
# false = the Content-Security-Policy is ENFORCED. There is no report endpoint
# (report-uri is empty and no route exists), so the browser console is the only
# signal of a violation: walk every back-office page on staging with
# enforcement on and the console open before go-live (checklist 6.3).
CSP_REPORT_ONLY=false

# Sessions, cache and queue run on the database; there is no Redis service.
# Cookies are sent only over https.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# Uploads: `local` writes to the host's disk (create shared/public/uploads
# before the first deploy so they survive releases, checklist 5.6); `s3` needs
# the AWS_* values below.
FILESYSTEM_DISK=local

# Operator tooling. Telescope records request, query and mail data: off.
TELESCOPE_ENABLED=false
# Operator IPs allowed to open Telescope, Pulse and /health (the last two fall
# back to this unless HEALTH_ALLOWED_IPS / PULSE_ALLOWED_IPS are set). Empty
# fails closed in production. Also needs a warehouse user with the admin role.
TELESCOPE_ALLOWED_IPS=
# HEALTH_ALLOWED_IPS=
# PULSE_ALLOWED_IPS=
# OWNER DECISION (checklist 2.12): Pulse stays gated by the allowlist above;
# set false to stop it recording (the route stays registered, still gated).
PULSE_ENABLED=true

# Health checks (`php artisan health:list`, page at /health). Unset, failure
# mails go to a reserved .invalid address and are lost: set a monitored inbox.
# HEALTH_TO_ADDRESS=ops@CHANGE_ME.example.com
# HEALTH_SECRET_TOKEN=
# Optional dead-man URL pinged by the scheduler heartbeat.
# SCHEDULE_HEARTBEAT_URL=

# Backups: `backup:run` refuses in production without the archive password.
# Keep that password somewhere other than this server. Set BACKUP_OFFSITE_DISK
# to a disk off this machine (s3 needs the AWS_* values below) so a lost server
# does not take its only backups with it.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_OFFSITE_DISK=s3
# BACKUP_NOTIFICATION_EMAIL=ops@CHANGE_ME.example.com

# Needed only for FILESYSTEM_DISK=s3 and BACKUP_OFFSITE_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=CHANGE_ME
AWS_BUCKET=CHANGE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail: a real provider. `log` would write every password reset, verification,
# health and backup mail to a file. Test it from /temp/admin/smtp-settings.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
# MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="CHANGE_ME@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Store integration. WMS_TOKEN is a NEW shared secret for the ERP's warehouse
# API (unset, /temp/api/v2/warehouse/* answers 401 to everyone); OTAJER_TOKEN is
# reissued by the ERP vendor. STORE_PRODUCTS_SYNC_URL carries its API key in the
# path, so treat it as a secret. Never reuse a value from the legacy store.
WMS_TOKEN=
OTAJER_URL=
OTAJER_TOKEN=
STORE_ASSET_BASE_URL=
STORE_PRODUCTS_SYNC_URL=

# Do not turn on the reCAPTCHA setting until both CAPTCHA_KEY and CAPTCHA_SECRET are set.
# The server check fails closed when the secret is missing or verification fails.
CAPTCHA_KEY=
CAPTCHA_SECRET=

# Read by the frontend build on the host, not by PHP.
VITE_APP_NAME="${APP_NAME}"
